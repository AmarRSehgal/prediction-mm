<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.amar.pmm_paper_report</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/amar/personal/prediction-mm/run_report.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/amar/personal/prediction-mm</string>
    <!-- 08:10 local, after polymarket_btc (07:45) so the two never push the site at once. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>10</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/amar/personal/prediction-mm/logs/launchd_report.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/amar/personal/prediction-mm/logs/launchd_report.err</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
