<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.amar.pmm_paper_baseline</string>

    <!-- Paper A/B arm, long-running. KeepAlive restarts it after a crash or a reboot;
         ThrottleInterval stops a crash loop from hammering the Kalshi API. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>-u</string>
        <string>PYTHONPATH</string>
        <string>/opt/local/bin/python3.13</string>
        <string>/Users/amar/personal/prediction-mm/scripts/paper_launch.py</string>
        <string>baseline</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/amar/personal/prediction-mm</string>

    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/amar/personal/prediction-mm/logs/launchd_paper_baseline.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/amar/personal/prediction-mm/logs/launchd_paper_baseline.err</string>
</dict>
</plist>
